{
  "$comment": "Validator config, not a token file — the design system itself is the CSS. Each pair is a foreground var that must stay legible on a background var, at a WCAG 2 ratio, in the listed modes. scripts/lint.mjs checks every pair against every brand. min: 4.5 = AA normal text, 3 = non-text/large. Disabled + decorative pairs are absent on purpose (WCAG 1.4.3 / 1.4.11 exempt them).",
  "pairs": [
    { "fg": "--color-text-primary",   "bg": "--color-bg-canvas",   "min": 4.5, "modes": ["light", "dark", "hc-light", "hc-dark"] },
    { "fg": "--color-text-primary",   "bg": "--color-bg-surface",  "min": 4.5, "modes": ["light", "dark"] },
    { "fg": "--color-text-secondary", "bg": "--color-bg-canvas",   "min": 4.5, "modes": ["light", "dark"] },
    { "fg": "--color-text-secondary", "bg": "--color-bg-surface",  "min": 4.5, "modes": ["light", "dark"] },
    { "fg": "--color-text-tertiary",  "bg": "--color-bg-canvas",   "min": 4.5, "modes": ["light", "dark"] },

    { "fg": "--color-text-on-accent", "bg": "--color-action-primary", "min": 4.5, "modes": ["light", "dark"] },
    { "fg": "--color-text-on-accent", "bg": "--color-action-danger",  "min": 4.5, "modes": ["light", "dark"] },

    { "fg": "--color-text-accent",  "bg": "--color-bg-canvas", "min": 4.5, "modes": ["light", "dark"] },
    { "fg": "--color-text-danger",  "bg": "--color-bg-canvas", "min": 4.5, "modes": ["light", "dark"] },
    { "fg": "--color-text-success", "bg": "--color-bg-canvas", "min": 4.5, "modes": ["light", "dark"] },
    { "fg": "--color-text-warning", "bg": "--color-bg-canvas", "min": 4.5, "modes": ["light", "dark"] },

    { "fg": "--color-text-accent",  "bg": "--color-bg-accent-subtle",  "min": 4.5, "modes": ["light", "dark"] },
    { "fg": "--color-text-danger",  "bg": "--color-bg-danger-subtle",  "min": 4.5, "modes": ["light", "dark"] },
    { "fg": "--color-text-success", "bg": "--color-bg-success-subtle", "min": 4.5, "modes": ["light", "dark"] },

    { "fg": "--color-border-default", "bg": "--color-bg-canvas",  "min": 3, "modes": ["light", "dark"] },
    { "fg": "--color-border-default", "bg": "--color-bg-surface", "min": 3, "modes": ["light", "dark"] },
    { "fg": "--color-border-focus",   "bg": "--color-bg-canvas",  "min": 3, "modes": ["light", "dark", "hc-light", "hc-dark"] }
  ]
}
